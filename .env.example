# =============================================================================
# Example environment configuration — PLACEHOLDERS ONLY. Never commit real values.
#
# Copy to `.env` for local development. In staging and production, values come
# from the host's secret store, not from files. The app validates these with Zod
# at boot and refuses to start when a required value is missing or inconsistent.
#
# Secret? = must never be exposed to browser code (no NEXT_PUBLIC_ prefix).
# Status  = which variables the code reads TODAY is shown in README.md. This file
#           is the planned configuration surface for Stages 1–8.
# =============================================================================

# ---- Core -------------------------------------------------------------------
NODE_ENV=development                         # development | test | production
APP_BASE_URL=http://localhost:3000           # public origin used in links and webhooks
LOG_LEVEL=info

# ---- Database (Secret? yes in shared environments) -------------------------
DATABASE_URL=postgresql://app_user:change-me@localhost:5432/commerce_dev?schema=public

# ---- Authentication and cryptography (Secret? yes) --------------------------
AUTH_SECRET=replace-with-32+-random-bytes     # Auth.js session signing
SESSION_ENCRYPTION_KEY=replace-with-32-bytes-base64
OTP_HMAC_KEY=replace-with-32+-random-bytes    # keys the HMAC of one-time codes

# ---- Single-tenant business defaults (MVP) ----------------------------------
BUSINESS_SLUG=sample-brand
DEFAULT_CURRENCY=NGN
DEFAULT_TIMEZONE=Africa/Lagos

# ---- Payments ----------------------------------------------------------------
PAYMENT_PROVIDER=MOCK                         # MOCK | PAYSTACK (FLUTTERWAVE later)
PAYSTACK_SECRET_KEY=                          # Secret? yes. sk_test_… in staging; sk_live_… only in production
PAYSTACK_WEBHOOK_IP_ALLOWLIST=                # optional, comma-separated; defence in depth only
PAYMENT_RESERVATION_MINUTES=30
REFUND_APPROVAL_THRESHOLD_MINOR=5000000       # kobo; 5,000,000 = ₦50,000

# ---- WhatsApp Cloud API -------------------------------------------------------
WHATSAPP_MODE=MOCK                            # MOCK | LIVE
WHATSAPP_GRAPH_VERSION=                       # pin to the version set in config when going live
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=                        # Secret? yes. System user token; never in the database
WHATSAPP_APP_SECRET=                          # Secret? yes. Verifies X-Hub-Signature-256
WHATSAPP_VERIFY_TOKEN=                        # Secret? yes. Any long random string; enter the same value in Meta

# ---- AI assistant -------------------------------------------------------------
AI_ENABLED=true
AI_PROVIDER=MOCK                              # MOCK | provider chosen in Stage 7 (decision D-04)
AI_API_KEY=                                   # Secret? yes
AI_MODEL=                                     # provider model id, set when a provider is chosen
AI_MONTHLY_SPEND_CAP_USD_CENTS=               # spend guard; the assistant falls back to the menu at the cap
AI_TURN_TIMEOUT_MS=15000

# ---- Object storage (product images) -----------------------------------------
STORAGE_PROVIDER=LOCAL                        # LOCAL (dev only) | S3 (S3-compatible)
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=                             # Secret? yes
S3_SECRET_ACCESS_KEY=                         # Secret? yes
PUBLIC_ASSET_BASE_URL=                        # CDN origin for product images

# ---- Email (staff invites, password resets) ----------------------------------
MAIL_PROVIDER=LOG                             # LOG (dev) | SMTP | PROVIDER
MAIL_FROM=no-reply@example.com
SMTP_URL=                                     # Secret? yes, if SMTP

# ---- Observability (optional) -------------------------------------------------
SENTRY_DSN=                                   # optional; error tracking

# ---- Worker -------------------------------------------------------------------
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_MS=2000
